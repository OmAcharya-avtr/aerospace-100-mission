cff-version: 1.2.0
title: "WahbaKit: static attitude determination from vector observations"
message: "If you use this software, please cite it as below."
type: software
authors:
  - name: "OPTIMA Organisation"
version: 0.1.0
date-released: "2026-08-31"
license: MIT
abstract: >-
  Wahba's problem solved four ways -- TRIAD, Davenport's q-method, QUEST and
  OLAE -- with attitude covariance derived from the per-observation measurement
  covariances, an explicit observability gate for near-parallel observations,
  and property tests against the analytic solution. Validation level 1
  (educational). Not flight qualified.
keywords:
  - Wahba's problem
  - attitude determination
  - QUEST
  - TRIAD
  - OLAE
references:
  - type: article
    authors:
      - family-names: Wahba
        given-names: Grace
    title: "A least squares estimate of satellite attitude"
    journal: "SIAM Review"
    volume: 7
    issue: 3
    start: 409
    year: 1965
  - type: article
    authors:
      - family-names: Shuster
        given-names: "Malcolm D."
      - family-names: Oh
        given-names: "S. D."
    title: "Three-axis attitude determination from vector observations"
    journal: "Journal of Guidance and Control"
    volume: 4
    issue: 1
    start: 70
    end: 77
    year: 1981
