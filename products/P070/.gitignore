# Byte-compiled and build products
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tool caches
.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
htmlcov/

# Scratch output of a local run. Every pattern below is anchored with a
# leading slash so that it matches ONLY at the repository root. A gitignore
# pattern with no slash matches at ANY depth: an unanchored `junit.xml` would
# also exclude a fixture of that name in a subdirectory, and an unanchored
# `report.json` would exclude one in examples/. That exact defect shipped in
# P060 of this portfolio, where a required committed fixture was silently
# excluded and a cold clone failed with 17 failures and 9 errors.
/junit.xml
/report.json
/report.md
/report.markdown
/structure.mmd
/escalation.png
/validate_*.log
