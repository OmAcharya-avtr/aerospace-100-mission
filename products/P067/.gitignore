# Every scratch pattern below is ANCHORED with a leading slash so that it
# matches only at the product root. A pattern with no slash matches at every
# depth: on 2026-10-10 a bare `junit.xml` in P060's own .gitignore silently
# excluded a required committed fixture, and a cold clone of that product
# failed with 17 failures and 9 errors. Every shipped file of this product was
# checked with `git check-ignore -v`; the result is recorded in
# validation/VALIDATION.md.

# Per-run pytest artifacts at the product root only.
/junit.xml

# Coverage artifacts at the product root only.
/.coverage
/.coverage.*
/htmlcov/

# Build artifacts at the product root only.
/build/
/dist/
/src/*.egg-info/
/.venv/
/venv/

# Caches. These are intentionally UNANCHORED: there is no depth at which any
# of them is a deliverable, and no committed file of this product is named
# after one.
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.ruff_cache/
